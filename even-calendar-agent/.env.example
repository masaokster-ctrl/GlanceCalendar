# サーバーがリッスンするポート
# Cloud Run では実行時に自動的に PORT 環境変数が設定されるため、通常は指定不要です。
PORT=8080

# Even AI からのリクエストを認証するための Bearer トークン
# Authorization: Bearer <この値> と一致しない場合、リクエストは 401 で拒否されます。
# 本番相当の環境では必ず推測困難なランダムな文字列を設定してください。
# 例: openssl rand -hex 32 などで生成した値
EVEN_AGENT_TOKEN=change-me-to-a-strong-random-token

# フェーズ0.5の調査用コマンド(遅延テスト・表示長テスト)を有効化するか
# 本番(Cloud Run)デプロイでは false にしてください。
ENABLE_PROBE_TESTS=false

# --- フェーズ1A: Google Calendar連携 ---

# /setup 管理画面へのログインに使う管理トークン(32バイト以上のランダム値を推奨)
SETUP_ADMIN_TOKEN=change-me-to-a-strong-random-token

# Google Cloud ConsoleでOAuth Web Applicationクライアントを作成して取得する値
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REDIRECT_URI=https://your-service-url/oauth2/callback

# 予定操作の対象タイムゾーン・カレンダー
TIME_ZONE=Asia/Tokyo
CALENDAR_ID=primary

# Firestore database ID (通常は既定の "(default)")
FIRESTORE_DATABASE_ID=(default)

# refresh tokenを保存するSecret Manager上のSecret名(値そのものはここに書かない)
GOOGLE_CALENDAR_REFRESH_TOKEN_SECRET=google-calendar-refresh-token
