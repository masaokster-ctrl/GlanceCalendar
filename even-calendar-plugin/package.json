{
  "name": "even-calendar-plugin",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:product": "tsc --noEmit && vite build --mode product",
    "preview": "vite preview",
    "pack": "evenhub pack",
    "package:product": "npm run build:product && evenhub pack app.json dist -o calendar-with-gemini-0.4.0.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.8.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.8.0",
    "globals": "^15.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.3"
  }
}
